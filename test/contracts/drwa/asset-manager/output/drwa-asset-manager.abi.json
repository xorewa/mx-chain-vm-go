                    "name": "token_id",
                    "type": "bytes"
                },
                {
                    "name": "carrier_type",
                    "type": "bytes"
                },
                {
                    "name": "asset_class",
                    "type": "bytes"
                },
                {
                    "name": "policy_id",
                    "type": "bytes"
                },
                {
                    "name": "regulated",
                    "type": "bool"
                },
                {
                    "name": "policy_version_at_register",
                    "type": "u64"
                },
                {
                    "docs": [
